{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/tdd-gate.sh\"",
            "timeout": 10,
            "statusMessage": "TDD gate"
          }
        ]
      }
    ]
  }
}
